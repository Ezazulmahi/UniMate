# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Only emails ending in these domains can sign up (comma separated).
ALLOWED_EMAIL_DOMAINS=edu,edu.bd,ac.bd

# Frontend address(es) allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173

# Uploaded resources are stored here.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Optional: enables AI review summaries and AI answers in the study assistant.
# Without it, both features still work using simple summaries and keyword search.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
